DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/ooves
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_BACKEND=redis://redis:6379/1
# Enable or disable Celery async mode (1 = enabled, 0 = disabled)
ENABLE_CELERY=1
# Perceptual hash cache time-to-live (in seconds)
PERCEPTUAL_CACHE_TTL=86400  # = 24 hours
# Loadtest mode (0 = normal, 1 = disable artificial delay)
LOADTEST_MODE=0
